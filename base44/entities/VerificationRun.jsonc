{
  "name": "VerificationRun",
  "type": "object",
  "description": "Orbitan Test Lab \u2014 Verification Campaign (Build #28.2Q-ZE.1). Represents ONE complete governance verification cycle. Server-generated immutable verification_run_id links TestRun \u2192 AIApproval \u2192 audit evidence \u2192 Orbit Inbox lifecycle. Build #28.2P-R.0R.1C-F hardens RLS to service-role-only writes using a single impossible user_condition and enforces legal lifecycle transitions server-side. Build #28.2P-R.0R.3 adds campaign_type to distinguish automated policy matrix verification from legacy manual live-identity verification and auth canary verification. Build #28.2Q-ZE.1 deprecates expected_identity_matrix for new zero-email campaigns \u2014 use expected_personas + expected_scenarios instead. Only platform.test_lab.manage may create or activate. Readiness is calculated against the currently active verification run only. Internal test infrastructure \u2014 never exposed to customer tenants. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "verification_run_id": {
      "type": "string",
      "description": "Server-generated immutable identifier e.g. 'vrun_2026_0001'. Never comes from the browser."
    },
    "created_by": {
      "type": "string",
      "description": "User ID of the platform admin who created this verification run."
    },
    "created_by_name": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the verification run transitioned to ACTIVE status."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the verification run transitioned to COMPLETED or FAILED status."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the verification run transitioned to ARCHIVED status."
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "active",
        "completed",
        "failed",
        "archived"
      ],
      "default": "preparing",
      "description": "Lifecycle state. Legal transitions: preparing \u2192 active \u2192 completed/failed \u2192 archived. Illegal: completed/failed/archived \u2192 active."
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "manual_live_identity",
        "automated_policy_matrix",
        "auth_canary"
      ],
      "description": "Build #28.2P-R.0R.3 \u2014 Campaign methodology. manual_live_identity = legacy 8-account manual verification (superseded). automated_policy_matrix = server-side automated policy verification. auth_canary = real authentication lifecycle verification (#28.2Q, superseded by zero-email policy in #28.2Q-ZE.1)."
    },
    "tenant_a_id": {
      "type": "string",
      "description": "Tenant A ID for this verification run."
    },
    "tenant_b_id": {
      "type": "string",
      "description": "Tenant B ID if provisioned. Null if not yet provisioned."
    },
    "expected_identity_matrix": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "@deprecated (Build #28.2Q-ZE.1) \u2014 Legacy email-oriented identity matrix. Retained for historical readability of existing VerificationRun records. New zero-email automated campaigns MUST NOT populate this field with email addresses \u2014 use expected_personas + expected_scenarios instead. Historical records remain readable."
    },
    "expected_personas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Build #28.2P-R.0R.3 \u2014 Canonical persona keys for automated campaigns e.g. ['tenant_a_requester', 'tenant_a_approver', ...]. Build #28.2Q-ZE.1 \u2014 This is the canonical identity reference for zero-email campaigns (replaces expected_identity_matrix)."
    },
    "expected_scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Expected test scenario tags e.g. ['approve_to_execute', 'cross_tenant_execution']."
    },
    "expected_proof_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "POLICY_UNIT",
          "BACKEND_INTEGRATION",
          "RLS",
          "REAL_AUTH"
        ]
      },
      "description": "Build #28.2P-R.0R.3 \u2014 Proof classes expected to be verified in this campaign. POLICY_UNIT and BACKEND_INTEGRATION for automated campaigns. RLS and REAL_AUTH deferred to manual/auth-canary campaigns."
    },
    "matrix_version": {
      "type": "string",
      "description": "Build #28.2P-R.0R.3 \u2014 Version of the verification matrix scenario registry used for this campaign."
    },
    "test_purpose": {
      "type": "string",
      "description": "Human-readable purpose of this verification campaign."
    },
    "non_production": {
      "type": "boolean",
      "default": true,
      "description": "Always true \u2014 internal test infrastructure excluded from production analytics."
    }
  },
  "required": [
    "verification_run_id",
    "created_by",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "delete": {
      "user_condition": {
        "role": "___service_only___"
      }
    }
  }
}