{
  "name": "PayrollSnapshot",
  "type": "object",
  "description": "OrbitanOS Workforce Module \u2014 Immutable payroll computation snapshot. Generated by TimesheetManager after manager validation locks a pay period. Source of truth for salary calculation. EXIT-READY: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_role": {
      "type": "string"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "monthly",
        "daily"
      ],
      "default": "hourly"
    },
    "pay_rate": {
      "type": "number",
      "description": "Rate at time of snapshot (hourly/daily/monthly)"
    },
    "currency": {
      "type": "string",
      "default": "SGD"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Pay period start date"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Pay period end date"
    },
    "total_shifts": {
      "type": "number",
      "default": 0,
      "description": "Number of validated clock records in this period"
    },
    "total_hours_worked": {
      "type": "number",
      "default": 0,
      "description": "Total regular hours worked"
    },
    "total_break_mins": {
      "type": "number",
      "default": 0
    },
    "total_overtime_hours": {
      "type": "number",
      "default": 0
    },
    "overtime_multiplier": {
      "type": "number",
      "default": 1.5,
      "description": "OT rate multiplier e.g. 1.5x"
    },
    "regular_pay": {
      "type": "number",
      "description": "total_hours_worked * pay_rate"
    },
    "overtime_pay": {
      "type": "number",
      "description": "total_overtime_hours * pay_rate * overtime_multiplier"
    },
    "gross_pay": {
      "type": "number",
      "description": "regular_pay + overtime_pay + allowances - deductions"
    },
    "allowances": {
      "type": "number",
      "default": 0,
      "description": "Transport, meal, or other allowances"
    },
    "deductions": {
      "type": "number",
      "default": 0,
      "description": "Unpaid leave, disciplinary deductions"
    },
    "cpf_employee": {
      "type": "number",
      "default": 0,
      "description": "CPF employee contribution (Singapore)"
    },
    "cpf_employer": {
      "type": "number",
      "default": 0,
      "description": "CPF employer contribution (Singapore)"
    },
    "net_pay": {
      "type": "number",
      "description": "gross_pay - cpf_employee - deductions"
    },
    "avg_productivity_score": {
      "type": "number",
      "description": "Average productivity across all shifts in period"
    },
    "validated_clock_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of ClockRecord IDs included in this snapshot"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "locked",
        "paid",
        "disputed"
      ],
      "default": "draft",
      "description": "draft = computed, locked = manager approved, paid = salary disbursed"
    },
    "locked_by": {
      "type": "string",
      "description": "Manager user ID who locked/approved this snapshot"
    },
    "locked_by_name": {
      "type": "string"
    },
    "locked_date": {
      "type": "string",
      "format": "date-time"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    },
    "dispute_reason": {
      "type": "string"
    },
    "finance_sync_id": {
      "type": "string",
      "description": "Linked FinanceSyncQueue ID after payroll is exported to ERP"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "outlet_id",
    "employee_id",
    "period_start",
    "period_end"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tenant_admin"
          }
        }
      ]
    }
  }
}