{
  "name": "GovernanceOverride",
  "type": "object",
  "description": "OrbitanOS Shield\u2122 \u2014 Global Override Request Registry. The 'Release Valve' for flexible governance. When a Shield policy blocks an action (clock-in without training, stock limit breach, finance threshold), the user can request a manager override. The manager approves/denies with a mandatory note + evidence document upload. Every override is immutable and linked to AuditLog for audit-bundle generation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant the override belongs to"
    },
    "outlet_id": {
      "type": "string",
      "description": "Outlet context (null = tenant-wide)"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "clock_in_compliance",
        "stock_limit",
        "finance_threshold",
        "schedule_breach",
        "compliance_gate",
        "custom"
      ],
      "description": "Which category of governance policy is being overridden"
    },
    "target_entity": {
      "type": "string",
      "description": "Entity the blocked action targeted e.g. ClockRecord, InventoryItem, PurchaseOrder"
    },
    "target_record_id": {
      "type": "string",
      "description": "ID of the record the blocked action was trying to create/update"
    },
    "policy_name": {
      "type": "string",
      "description": "The GovernancePolicy.policy_name that triggered the block"
    },
    "block_reason": {
      "type": "string",
      "description": "Why the Shield blocked the action (copied from policy description at block time)"
    },
    "requested_by_id": {
      "type": "string",
      "description": "User ID of the person requesting the override (usually the worker)"
    },
    "requested_by_name": {
      "type": "string"
    },
    "requested_by_role": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date-time"
    },
    "requester_notes": {
      "type": "string",
      "description": "Why the requester believes the override is justified"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired"
      ],
      "default": "pending"
    },
    "reviewed_by_id": {
      "type": "string",
      "description": "Manager user ID who reviewed the override"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_by_role": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "manager_notes": {
      "type": "string",
      "description": "MANDATORY justification from the manager when approving/denying. This is the accountability field."
    },
    "evidence_document_url": {
      "type": "string",
      "description": "Uploaded document URL \u2014 certificate, photo, signed waiver, or any supporting evidence for audit purposes"
    },
    "evidence_document_name": {
      "type": "string",
      "description": "Original filename of the uploaded evidence"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this override request expires if not reviewed"
    },
    "audit_log_id": {
      "type": "string",
      "description": "Links to the AuditLog entry recording the final override decision (approved/denied)"
    },
    "shield_mode": {
      "type": "string",
      "enum": [
        "auditor",
        "guardian"
      ],
      "description": "Shield mode under which this override was evaluated"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Severity of the original policy violation"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "request_type",
    "target_entity",
    "requested_by_id",
    "requested_date",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.requested_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.requested_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tenant_admin"
          }
        }
      ]
    }
  }
}