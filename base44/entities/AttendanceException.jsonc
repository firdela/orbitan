{
  "name": "AttendanceException",
  "type": "object",
  "description": "OrbitanOS Workforce Operations \u2014 Attendance Exception Record (ADR-0052 Policy Engine). Generated by the Attendance Policy evaluation engine when a ClockRecord deviates from the active attendance policy. Each exception flows through a governed lifecycle: detected \u2192 pending_review \u2192 employee_justified \u2192 manager_review \u2192 approved/rejected \u2192 timesheet_updated. Manager decisions are fully audited via AuditLog. Policies are read from the policy registry (never hardcoded) so per-tenant configuration is possible without code changes. RLS NOTE: Employees may READ their own exceptions but may NOT directly UPDATE them \u2014 all writes go through controlled backend functions (employeeJustify, attendanceReview) that enforce field-level separation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string",
      "description": "Employee/User ID the exception applies to"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_role": {
      "type": "string"
    },
    "shift_id": {
      "type": "string",
      "description": "Linked Shift record (null for off-day attendance)"
    },
    "clock_record_id": {
      "type": "string",
      "description": "Linked ClockRecord that triggered the exception"
    },
    "exception_type": {
      "type": "string",
      "enum": [
        "late_clock_in",
        "early_clock_out",
        "missed_clock_out",
        "missed_break",
        "extended_break",
        "overtime",
        "off_day_attendance",
        "outside_geofence",
        "duplicate_clock",
        "manual_entry"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "string",
      "description": "Auto-generated description of the deviation (from the policy engine)"
    },
    "policy_version": {
      "type": "string",
      "description": "Version of the attendance policy under which this exception was evaluated"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "pending_review",
        "employee_justified",
        "manager_review",
        "approved",
        "rejected",
        "timesheet_updated"
      ],
      "default": "pending_review",
      "description": "Governed lifecycle state. detected \u2192 pending_review \u2192 employee_justified (optional) \u2192 manager_review \u2192 approved/rejected \u2192 timesheet_updated."
    },
    "employee_justification": {
      "type": "string",
      "description": "Reason submitted by the employee for the deviation. Set only by employeeJustify backend function."
    },
    "employee_justified_at": {
      "type": "string",
      "format": "date-time"
    },
    "supporting_notes": {
      "type": "string"
    },
    "supporting_attachment_url": {
      "type": "string",
      "description": "Optional photo/document evidence URL"
    },
    "reviewer_id": {
      "type": "string",
      "description": "Manager who reviewed and approved/rejected the exception"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "manager_decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ],
      "description": "Final manager decision"
    },
    "manager_notes": {
      "type": "string",
      "description": "Manager's notes on the decision"
    },
    "resolution": {
      "type": "string",
      "description": "How the exception was resolved (e.g., 'hours adjusted', 'no action', 'coaching scheduled')"
    },
    "timesheet_adjusted": {
      "type": "boolean",
      "default": "false",
      "description": "True once the linked ClockRecord was adjusted based on this decision"
    },
    "audit_log_id": {
      "type": "string",
      "description": "Linked AuditLog entry for the manager's decision"
    }
  },
  "required": [
    "tenant_id",
    "employee_id",
    "exception_type",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "data.employee_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    }
  }
}