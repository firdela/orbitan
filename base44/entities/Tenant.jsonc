{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organisation name"
    },
    "legal_name": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "enum": [
        "food_beverage",
        "recycling_sustainability",
        "retail",
        "healthcare",
        "education",
        "logistics",
        "events_activations",
        "technology_software",
        "facilities_management",
        "other"
      ]
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "orbitan_starter",
        "orbitan_growth",
        "orbitan_business",
        "orbitan_enterprise"
      ],
      "default": "orbitan_starter"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial",
        "cancelled",
        "onboarding"
      ],
      "default": "onboarding"
    },
    "manifest_key": {
      "type": "string",
      "description": "PlatformManifest.manifest_key this tenant uses for UI/navigation rendering. Null = legacy fallback nav. Set during provisioning (e.g. 'core_ops_v1')."
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Module keys enabled for this tenant"
    },
    "enabled_packs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Industry pack keys enabled for this tenant"
    },
    "feature_flags": {
      "type": "object",
      "description": "Key-value feature flag overrides for this tenant"
    },
    "governance_domain": {
      "type": "string",
      "description": "Shield governance domain \u2014 resolved from ActivationRegistry at provisioning. e.g. 'fnb_standard_ops'. The shieldInterceptor binds GovernancePolicy records matching this domain for domain-aware policy resolution."
    },
    "max_employees": {
      "type": "number",
      "default": 10
    },
    "contact_email": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Singapore"
    },
    "currency": {
      "type": "string",
      "default": "SGD"
    },
    "logo_url": {
      "type": "string"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "trial_ends_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "industry",
    "subscription_plan"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}