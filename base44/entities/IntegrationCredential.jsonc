{
  "name": "IntegrationCredential",
  "type": "object",
  "description": "OrbitanOS Delegated Integration Hub \u2014 Per-tenant OAuth credential vault for external services (Xero, QuickBooks, etc.). Stores access/refresh tokens with strict tenant isolation. Backend functions write tokens via service role after OAuth callback. Prevents cross-tenant data exposure. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this credential belongs to"
    },
    "service_type": {
      "type": "string",
      "description": "External service key e.g. 'xero', 'quickbooks', 'myob', 'shopify', 'google_workspace'"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "expired",
        "error"
      ],
      "default": "connected",
      "description": "Connection health state"
    },
    "access_token": {
      "type": "string",
      "description": "OAuth access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "OAuth refresh token for token renewal"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the access token expires"
    },
    "external_tenant_id": {
      "type": "string",
      "description": "Service-specific tenant/org ID (e.g. Xero tenant ID)"
    },
    "external_tenant_name": {
      "type": "string",
      "description": "Human-readable name from the external service"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OAuth scopes granted by the user"
    },
    "connected_by_id": {
      "type": "string",
      "description": "User ID who initiated the connection"
    },
    "connected_by_name": {
      "type": "string"
    },
    "connected_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_refreshed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the OAuth token was refreshed"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message if status is 'error'"
    }
  },
  "required": [
    "tenant_id",
    "service_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}