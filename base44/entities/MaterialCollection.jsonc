{
  "name": "MaterialCollection",
  "type": "object",
  "description": "Recycling & Sustainability Pack \u2014 tracks waste/material collection jobs, processing status, and sustainability impact metrics for Renewed Resources Pte Ltd.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "collection_reference": {
      "type": "string"
    },
    "collection_date": {
      "type": "string",
      "format": "date"
    },
    "collection_type": {
      "type": "string",
      "enum": [
        "scheduled_pickup",
        "drop_off",
        "on_demand",
        "partner_transfer"
      ],
      "default": "scheduled_pickup"
    },
    "material_category": {
      "type": "string",
      "enum": [
        "paper_cardboard",
        "plastics",
        "metals",
        "e_waste",
        "glass",
        "textiles",
        "organic",
        "mixed",
        "hazardous",
        "other"
      ],
      "default": "mixed"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "industrial",
        "partner_organisation",
        "government",
        "retail"
      ],
      "default": "commercial"
    },
    "source_name": {
      "type": "string"
    },
    "source_address": {
      "type": "string"
    },
    "source_lat": {
      "type": "number"
    },
    "source_lng": {
      "type": "number"
    },
    "gross_weight_kg": {
      "type": "number"
    },
    "net_weight_kg": {
      "type": "number"
    },
    "contamination_pct": {
      "type": "number",
      "default": 0
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "collected",
        "in_transit",
        "received_at_facility",
        "sorting",
        "processed",
        "dispatched",
        "completed"
      ],
      "default": "collected"
    },
    "processing_facility": {
      "type": "string"
    },
    "processed_date": {
      "type": "string",
      "format": "date"
    },
    "recovered_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material_type": {
            "type": "string"
          },
          "weight_kg": {
            "type": "number"
          },
          "estimated_value_sgd": {
            "type": "number"
          },
          "disposed_via": {
            "type": "string"
          }
        }
      }
    },
    "co2_saved_kg": {
      "type": "number"
    },
    "trees_saved_equivalent": {
      "type": "number"
    },
    "water_saved_litres": {
      "type": "number"
    },
    "sustainability_score": {
      "type": "number"
    },
    "assigned_driver_id": {
      "type": "string"
    },
    "assigned_driver_name": {
      "type": "string"
    },
    "vehicle_registration": {
      "type": "string"
    },
    "supplier_partner_id": {
      "type": "string"
    },
    "linked_inventory_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photo_evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificate_url": {
      "type": "string"
    },
    "revenue_sgd": {
      "type": "number"
    },
    "cost_sgd": {
      "type": "number"
    },
    "net_value_sgd": {
      "type": "number"
    },
    "compliance_verified": {
      "type": "boolean",
      "default": false
    },
    "compliance_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "collection_date",
    "material_category"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    }
  }
}