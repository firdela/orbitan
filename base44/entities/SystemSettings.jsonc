{
  "name": "SystemSettings",
  "type": "object",
  "description": "OrbitanOS Global Governance Registry \u2014 singleton record controlling platform-wide maintenance mode, shield posture, AI kill switch, governance mode, and feature flags. Powered by the Regulate principle. Exit-Ready.",
  "properties": {
    "maintenance_mode": {
      "type": "boolean",
      "default": false,
      "description": "Global kill-switch. When true, all tenant app users see MaintenanceView."
    },
    "maintenance_title": {
      "type": "string",
      "default": "Scheduled Maintenance",
      "description": "Headline shown on the MaintenanceView"
    },
    "maintenance_message": {
      "type": "string",
      "description": "Detailed explanation shown to users during maintenance"
    },
    "expected_resume_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expected time the platform will return to full operation"
    },
    "shield_level": {
      "type": "string",
      "enum": [
        "auditor",
        "guardian"
      ],
      "default": "auditor",
      "description": "Platform-wide Shield posture. guardian = block high-risk actions globally."
    },
    "nexus_ai_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Orbit Nexus AI Kill Switch. When false, ALL AI intelligence requests return a graceful 'ai_disabled' response. OrbitanOS core modules continue operating fully without AI. Used for emergencies, cost control, or compliance lockdown."
    },
    "nexus_ai_disabled_message": {
      "type": "string",
      "default": "AI intelligence is currently disabled by the platform administrator. All OrbitanOS modules continue to operate normally.",
      "description": "Message returned to the frontend when AI is disabled, shown in AI-augmented UI components."
    },
    "nexus_ai_disabled_reason": {
      "type": "string",
      "description": "Internal reason for disabling AI (e.g. 'Emergency cost freeze', 'Compliance investigation', 'Model provider outage'). Admin-only."
    },
    "ai_governance_mode": {
      "type": "string",
      "enum": [
        "passive_logging",
        "proactive_approval"
      ],
      "default": "proactive_approval",
      "description": "Orbit Nexus AI governance mode. passive_logging = AI actions are logged to AuditLog after execution (operational velocity). proactive_approval = AI creates GovernanceOverride / EvolutionProposal and waits for human approval before high-impact actions (compliance-first)."
    },
    "orbit_evolution_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Orbit Evolution switch. When true, Orbit Nexus continuously observes usage patterns and generates EvolutionProposal records for improvement opportunities. When false, no proposals are generated."
    },
    "allow_admin_access_during_maintenance": {
      "type": "boolean",
      "default": true,
      "description": "If true, admin users bypass the MaintenanceView and retain full access"
    },
    "platform_version": {
      "type": "string",
      "description": "Current live platform version string e.g. 1.4.2"
    },
    "status_message": {
      "type": "string",
      "description": "Optional public-facing status message shown in the app header (e.g. 'Degraded performance on Xero sync')"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}