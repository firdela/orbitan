{
  "name": "DashboardLayout",
  "type": "object",
  "description": "OrbitanOS \u2014 Per-tenant, per-role dashboard widget layout config. Stores the ordered, visible widget arrangement so each team can customise their dashboard via drag-and-drop. Powers the Blueprint Studio 'editable layouts' capability. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this layout belongs to"
    },
    "dashboard_key": {
      "type": "string",
      "description": "Identifier of the dashboard this layout customises e.g. workspace_dashboard, fnb_dashboard, outlet_dashboard"
    },
    "role": {
      "type": "string",
      "default": "default",
      "description": "Role this layout is customised for. 'default' applies to all roles unless a role-specific layout exists."
    },
    "widget_config": {
      "type": "array",
      "description": "Ordered list of widgets with visibility. Order = display order; visible = whether the widget renders.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Widget identifier matching the dashboard's widget registry"
          },
          "visible": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "tenant_id",
    "dashboard_key",
    "widget_config"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}