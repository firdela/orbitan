{
  "name": "Company",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Singapore"
    },
    "logo_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ]
}