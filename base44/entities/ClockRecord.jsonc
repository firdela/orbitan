{
  "name": "ClockRecord",
  "type": "object",
  "description": "Corporate-grade clock-in/out records with GPS, photo verification, break tracking, and productivity metrics. Source of truth for attendance and payroll. Breaks are tracked as real events (break_start_time / break_end_time); break_duration_mins is calculated from actual events. Manager validation_status gates payroll inclusion. EXIT-READY: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_role": {
      "type": "string"
    },
    "pay_rate": {
      "type": "number",
      "description": "Employee pay rate at time of shift (captured for immutability)"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "monthly",
        "daily"
      ],
      "default": "hourly"
    },
    "overtime_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "shift_id": {
      "type": "string",
      "description": "Linked Shift record"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "clock_in_method": {
      "type": "string",
      "enum": [
        "pin",
        "qr",
        "geo",
        "photo",
        "manual"
      ],
      "default": "pin"
    },
    "clock_in_lat": {
      "type": "number",
      "description": "GPS latitude at clock-in"
    },
    "clock_in_lng": {
      "type": "number",
      "description": "GPS longitude at clock-in"
    },
    "clock_in_geo_verified": {
      "type": "boolean",
      "default": false
    },
    "clock_in_photo_url": {
      "type": "string",
      "description": "Selfie photo at clock-in"
    },
    "clock_in_photo_verified": {
      "type": "boolean",
      "default": false
    },
    "clock_out_time": {
      "type": "string",
      "format": "date-time"
    },
    "clock_out_lat": {
      "type": "number"
    },
    "clock_out_lng": {
      "type": "number"
    },
    "clock_out_geo_verified": {
      "type": "boolean",
      "default": false
    },
    "clock_out_photo_url": {
      "type": "string"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled shift start time for lateness calculation. Populated from linked Shift on clock_in."
    },
    "scheduled_end": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled shift end time for early-departure and missed-clock-out detection."
    },
    "late_mins": {
      "type": "number",
      "default": 0,
      "description": "Minutes late vs scheduled start"
    },
    "early_leave_mins": {
      "type": "number",
      "default": 0
    },
    "break_start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when break started (real event, not inferred)"
    },
    "break_end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when break ended (real event, not inferred)"
    },
    "break_duration_mins": {
      "type": "number",
      "default": 0,
      "description": "Calculated from break_end_time - break_start_time. 0 if no break taken."
    },
    "total_hours_worked": {
      "type": "number",
      "description": "Calculated hours between clock-in and clock-out minus break duration"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "labour_cost": {
      "type": "number",
      "description": "total_hours_worked * pay_rate (regular hours)"
    },
    "overtime_cost": {
      "type": "number",
      "description": "overtime_hours * pay_rate * overtime_multiplier"
    },
    "total_shift_cost": {
      "type": "number",
      "description": "labour_cost + overtime_cost"
    },
    "status": {
      "type": "string",
      "enum": [
        "clocked_in",
        "on_break",
        "clocked_out",
        "absent",
        "pending_verification"
      ],
      "default": "clocked_in"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "disputed"
      ],
      "default": "pending",
      "description": "Manager validation state \u2014 must be approved before payroll inclusion. Updated transactionally by attendanceReview backend function."
    },
    "tasks_assigned": {
      "type": "number",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "productivity_score": {
      "type": "number",
      "description": "(tasks_completed / tasks_assigned) * 100"
    },
    "verified_by": {
      "type": "string",
      "description": "Manager who verified this record"
    },
    "verified_by_name": {
      "type": "string"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason if manager rejects this clock record"
    },
    "payroll_snapshot_id": {
      "type": "string",
      "description": "Linked PayrollSnapshot once included in a pay run"
    },
    "payroll_locked": {
      "type": "boolean",
      "default": false,
      "description": "True once included in a locked PayrollSnapshot \u2014 immutable"
    },
    "payroll_export_eligible": {
      "type": "boolean",
      "default": false,
      "description": "True once validation_status is approved and the record is ready for payroll export"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "outlet_id",
    "employee_id",
    "date"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.outlet_id": "{{user.data.outlet_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}"
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.employee_id": "{{user.id}}",
          "data.payroll_locked": false
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "outlet_manager"
          }
        }
      ]
    }
  }
}