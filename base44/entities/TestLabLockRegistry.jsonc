{
  "name": "TestLabLockRegistry",
  "type": "object",
  "description": "Orbitan Test Lab \u2014 Atomic Operation Lock Registry (Build #28.2P-R.0R.1C). Singleton record that owns the active_locks array. Atomic CAS ($ne + $push on a single document) prevents check-then-create races for privileged Test Lab operations. The service role bypasses RLS to mutate; no app user can directly create/update/delete. Build #28.2P-R.0R.1C-F uses a single impossible user_condition for clearer service-only boundary. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "registry_key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'test_lab_global'. Used to find the registry record."
    },
    "active_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lock_key": {
            "type": "string",
            "description": "Deterministic lock key: target_type:target_key"
          },
          "operation_id": {
            "type": "string",
            "description": "The operation_id that acquired this lock."
          },
          "acquired_at": {
            "type": "string",
            "format": "date-time"
          },
          "target_type": {
            "type": "string"
          },
          "target_key": {
            "type": "string"
          }
        }
      },
      "description": "Active operation locks. CAS-acquired via $ne + $push (atomic on single document), released via $pull on terminal states."
    },
    "non_production": {
      "type": "boolean",
      "default": true,
      "description": "Always true \u2014 internal test infrastructure excluded from production analytics."
    }
  },
  "required": [
    "registry_key",
    "active_locks"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "delete": {
      "user_condition": {
        "role": "___service_only___"
      }
    }
  }
}