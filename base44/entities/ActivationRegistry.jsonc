{
  "name": "ActivationRegistry",
  "type": "object",
  "description": "OrbitanOS Activation Engine \u2014 Registry-Driven Provisioning. Versioned JSON manifests defining 'seeder pipelines' and industry blueprints for tenant onboarding across all industries. Replaces hardcoded INDUSTRY_BLUEPRINT logic. Powers the Manifest-Driven architecture. Now includes trust_pillars capability manifest for registry-driven compliance scoring. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "pack_key": {
      "type": "string",
      "description": "Industry pack identifier e.g. 'fnb', 'retail', 'recycling', 'logistics'"
    },
    "pack_name": {
      "type": "string",
      "description": "Human-readable pack name e.g. 'Food & Beverage Operations Pack'"
    },
    "industry": {
      "type": "string",
      "description": "Tenant.industry enum value this pack provisions for"
    },
    "manifest_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Semantic version of this blueprint manifest"
    },
    "governance_domain": {
      "type": "string",
      "description": "Shield domain identifier for policy resolution e.g. 'fnb_standard_ops', 'retail_standard_ops'. The shieldInterceptor resolves GovernancePolicy records matching this domain."
    },
    "description": {
      "type": "string"
    },
    "seeder_pipeline": {
      "type": "array",
      "description": "Ordered provisioning steps executed by onboardingService. Each step references a function and defines execution order + criticality.",
      "items": {
        "type": "object",
        "properties": {
          "step_name": {
            "type": "string",
            "description": "Identifier e.g. 'seed_compliance_records', 'generate_sop_documents'"
          },
          "order": {
            "type": "number",
            "description": "Execution priority (1 = first)"
          },
          "is_critical": {
            "type": "boolean",
            "default": true,
            "description": "Critical steps halt provisioning on failure; non-critical steps log and continue"
          }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "description": "Industry scaffolding \u2014 compliance templates and setup tasks. NOT fictional business data. Consumed by onboardingService.provisionOrganisation.",
      "properties": {
        "compliance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "food_safety",
                  "fire_safety",
                  "licensing",
                  "hr",
                  "environmental",
                  "financial",
                  "other"
                ]
              }
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "module_context": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "urgent"
                ],
                "default": "medium"
              }
            }
          }
        }
      }
    },
    "ai_documents": {
      "type": "array",
      "description": "AI-generated documents to create during activation (SOPs, checklists, shift briefs)",
      "items": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "enum": [
              "sop",
              "training_module",
              "policy",
              "shift_brief",
              "incident_report",
              "compliance_checklist"
            ]
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "ai_governance": {
      "type": "object",
      "description": "AI-Native governance binding for Agentic AI. Defines which agents are enabled and their trust boundaries under this pack.",
      "properties": {
        "enabled_agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Agent slugs enabled for this pack e.g. ['inventory_agent', 'finance_agent']"
        },
        "agent_trust_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "low = agent requires approval for all writes | medium = autonomous within budget gates | high = autonomous (enterprise only)"
        },
        "rag_knowledge_domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Knowledge domains indexed for RAG retrieval e.g. ['fnb_sop', 'safety_regulations']"
        },
        "required_governance_gates": {
          "type": "array",
          "description": "Actions an agent cannot take without human approval",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "requires_human_approval": {
                "type": "boolean",
                "default": true
              },
              "max_threshold_sgd": {
                "type": "number",
                "description": "Auto-approve below this SGD threshold, block above"
              }
            }
          }
        }
      }
    },
    "trust_pillars": {
      "type": "object",
      "description": "Registry-driven capability manifest for the complianceScoreboard aggregator. Defines which entities to monitor per pillar and weights for trust score synthesis. The aggregator reads this manifest dynamically \u2014 zero hardcoded industry logic. Adding a new industry = add trust_pillars to its ActivationRegistry record.",
      "properties": {
        "regulatory": {
          "type": "object",
          "description": "Regulatory compliance pillar \u2014 typically ComplianceRecord ratio of approved/submitted vs total.",
          "properties": {
            "target_entity": {
              "type": "string",
              "description": "Entity to query e.g. 'ComplianceRecord'"
            },
            "filter": {
              "type": "object",
              "description": "Additional filter beyond tenant_id e.g. {category: 'food_safety'}"
            },
            "weight": {
              "type": "number",
              "default": 0.4
            },
            "scoring_mode": {
              "type": "string",
              "enum": [
                "ratio_healthy",
                "violation_count",
                "count_penalty"
              ],
              "default": "ratio_healthy"
            },
            "healthy_statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Statuses counted as healthy for ratio_healthy mode"
            },
            "penalty_per_unit": {
              "type": "number",
              "default": 10,
              "description": "Penalty per unit for count_penalty / violation_count modes"
            },
            "label": {
              "type": "string",
              "description": "Display label for this pillar"
            }
          }
        },
        "governance": {
          "type": "object",
          "description": "Shield governance pillar \u2014 typically GovernancePolicy violation count.",
          "properties": {
            "target_entity": {
              "type": "string"
            },
            "filter": {
              "type": "object"
            },
            "weight": {
              "type": "number",
              "default": 0.3
            },
            "scoring_mode": {
              "type": "string",
              "enum": [
                "ratio_healthy",
                "violation_count",
                "count_penalty"
              ],
              "default": "violation_count"
            },
            "healthy_statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "penalty_per_unit": {
              "type": "number",
              "default": 2
            },
            "label": {
              "type": "string"
            }
          }
        },
        "integrity": {
          "type": "object",
          "description": "Audit integrity pillar \u2014 typically AuditLog blocked Shield outcomes.",
          "properties": {
            "target_entity": {
              "type": "string"
            },
            "filter": {
              "type": "object"
            },
            "weight": {
              "type": "number",
              "default": 0.2
            },
            "scoring_mode": {
              "type": "string",
              "enum": [
                "ratio_healthy",
                "violation_count",
                "count_penalty"
              ],
              "default": "count_penalty"
            },
            "healthy_statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "penalty_per_unit": {
              "type": "number",
              "default": 10
            },
            "label": {
              "type": "string"
            }
          }
        },
        "operational": {
          "type": "object",
          "description": "Operational velocity pillar \u2014 typically pending high-priority tasks.",
          "properties": {
            "target_entity": {
              "type": "string"
            },
            "filter": {
              "type": "object"
            },
            "weight": {
              "type": "number",
              "default": 0.1
            },
            "scoring_mode": {
              "type": "string",
              "enum": [
                "ratio_healthy",
                "violation_count",
                "count_penalty"
              ],
              "default": "count_penalty"
            },
            "healthy_statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "penalty_per_unit": {
              "type": "number",
              "default": 10
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "min_plan_required": {
      "type": "string",
      "enum": [
        "orbitan_free",
        "orbitan_starter",
        "orbitan_growth",
        "orbitan_business",
        "orbitan_enterprise"
      ],
      "default": "orbitan_starter",
      "description": "Minimum subscription tier to activate this pack"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this pack is available for new tenant onboarding"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in pack selection UI"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pack_key",
    "pack_name",
    "industry",
    "governance_domain",
    "blueprint"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}