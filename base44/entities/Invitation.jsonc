{
  "name": "Invitation",
  "type": "object",
  "description": "OrbitanOS Enterprise Invitation Registry \u2014 Governed onboarding pipeline. Tracks every invitation code issued for worker access. Supports role scoping, outlet binding, expiry, and revocation. Regulate principle. Exit-Ready.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Target tenant the worker is invited to"
    },
    "outlet_id": {
      "type": "string",
      "description": "Target outlet (null = tenant-wide invitation)"
    },
    "company_id": {
      "type": "string",
      "description": "Target company / brand"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invitation code (e.g. LBT-NBR-001)"
    },
    "invited_role": {
      "type": "string",
      "enum": [
        "worker",
        "supervisor",
        "outlet_manager"
      ],
      "default": "worker",
      "description": "Role granted upon redemption"
    },
    "invited_email": {
      "type": "string",
      "description": "Optional: pre-assigned email for the invited worker"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "redeemed",
        "expired",
        "revoked"
      ],
      "default": "active",
      "description": "Current state of this invitation"
    },
    "issued_by_id": {
      "type": "string",
      "description": "User ID of the manager who issued this invitation"
    },
    "issued_by_name": {
      "type": "string",
      "description": "Name of the manager who issued"
    },
    "issued_by_role": {
      "type": "string",
      "description": "Role of the issuer at time of issuance"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this invitation expires"
    },
    "redeemed_by_email": {
      "type": "string",
      "description": "Email of the worker who redeemed this invitation"
    },
    "redeemed_date": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by_id": {
      "type": "string"
    },
    "revoked_date": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_reason": {
      "type": "string"
    },
    "max_uses": {
      "type": "number",
      "default": 1,
      "description": "Maximum number of redemptions (1 = single use)"
    },
    "use_count": {
      "type": "number",
      "default": 0,
      "description": "Current redemption count"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "invite_code",
    "invited_role",
    "issued_by_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tenant_admin"
          }
        }
      ]
    }
  }
}