{
  "name": "TestLabAttestation",
  "type": "object",
  "description": "Orbitan Test Lab \u2014 Persisted email delivery attestation record (Build #28.2P-R.0R.1C-F). Stores per-alias, per-check attestation state so readiness can be computed from persisted evidence rather than transient audit log entries. Never stores private destination addresses, passwords, invitation links, tokens, or message content. Build #28.2P-R.0R.1C-F hardens RLS to service-role-only writes using a single impossible user_condition. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant context (platform for platform-level attestations)."
    },
    "alias": {
      "type": "string",
      "description": "Test identity email alias being attested e.g. 'test.requester.a@orbitan.net'. Must be in the fixed test-identity allowlist."
    },
    "check_key": {
      "type": "string",
      "description": "Attestation check identifier e.g. 'ordinary_test_email_received', 'invitation_email_received'."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this check has been verified as passing."
    },
    "attested_by_id": {
      "type": "string",
      "description": "User ID of the platform admin who attested this check."
    },
    "attested_by_name": {
      "type": "string"
    },
    "attested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the attestation was recorded."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the attestation was last updated."
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "manual_verification",
        "automated_check",
        "corrected",
        "revoked"
      ],
      "default": "manual_verification",
      "description": "Type of evidence supporting this attestation."
    },
    "non_production": {
      "type": "boolean",
      "default": true,
      "description": "Always true \u2014 test record excluded from production analytics."
    }
  },
  "required": [
    "alias",
    "check_key",
    "verified"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "___service_only___"
      }
    },
    "delete": {
      "user_condition": {
        "role": "___service_only___"
      }
    }
  }
}