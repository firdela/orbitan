{
  "name": "Outlet",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "restaurant",
        "retail_store",
        "warehouse",
        "office",
        "event_site",
        "campus",
        "processing_facility",
        "virtual",
        "other"
      ],
      "default": "other"
    },
    "operating_hours": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "is_virtual": {
      "type": "boolean",
      "default": false,
      "description": "True for Home-Based Business (HBB) or pre-incorporation virtual operations. No physical commercial premises."
    },
    "invite_code": {
      "type": "string",
      "description": "Outlet-level invitation code for worker onboarding (e.g. LBT-NBR-001)"
    },
    "invite_code_expiry": {
      "type": "string",
      "format": "date-time",
      "description": "When this invite code expires"
    },
    "invite_code_role": {
      "type": "string",
      "enum": [
        "worker",
        "supervisor",
        "outlet_manager"
      ],
      "description": "Role this invite code grants on redemption"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "temporarily_closed",
        "onboarding"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "client_manager"
                  }
                },
                {
                  "data.id": "{{user.data.outlet_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}