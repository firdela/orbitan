{
  "name": "Outlet",
  "type": "object",
  "description": "OrbitanOS Facility \u2014 a physical or virtual operating location within an organisation. Extended with the Facility Settings module (ADR): structured operating hours, business days, holiday schedule, location coordinates, and a flexible facility_settings JSON object for industry-specific preferences. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Full street address of the facility"
    },
    "type": {
      "type": "string",
      "enum": [
        "restaurant",
        "retail_store",
        "warehouse",
        "office",
        "event_site",
        "campus",
        "processing_facility",
        "virtual",
        "other"
      ],
      "default": "other"
    },
    "operating_hours": {
      "type": "string",
      "description": "Human-readable operating hours summary e.g. '11:00 AM - 10:00 PM'. Kept for backward-compatible display; the structured weekly_hours field is the source of truth."
    },
    "weekly_hours": {
      "type": "object",
      "description": "Structured per-day operating hours keyed by JS getDay() index (0=Sunday \u2026 6=Saturday). Source of truth for scheduling, compliance, and worker portal.",
      "properties": {
        "0": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "1": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "2": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "3": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "4": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "5": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "6": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "is_closed": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "business_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Day indices (0=Sunday \u2026 6=Saturday) the business operates. Derived from weekly_hours.is_closed; stored for efficient querying."
    },
    "holidays": {
      "type": "array",
      "description": "Facility-specific holiday / closure schedule. Each entry overrides weekly_hours for that date.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "name": {
            "type": "string"
          },
          "is_closed": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude for geo-fenced clock-in and maps"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude for geo-fenced clock-in and maps"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Singapore",
      "description": "IANA timezone for this facility (scheduling + reminders). Defaults to tenant timezone."
    },
    "facility_settings": {
      "type": "object",
      "description": "Flexible, industry-agnostic facility preferences. Industry Packs extend this object without schema migrations. Common keys: max_capacity, accepts_walk_ins, requires_reservation, has_parking, wheelchair_accessible.",
      "properties": {
        "max_capacity": {
          "type": "number"
        },
        "accepts_walk_ins": {
          "type": "boolean"
        },
        "requires_reservation": {
          "type": "boolean"
        },
        "has_parking": {
          "type": "boolean"
        },
        "wheelchair_accessible": {
          "type": "boolean"
        }
      }
    },
    "contact_person": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "is_virtual": {
      "type": "boolean",
      "default": false,
      "description": "True for Home-Based Business (HBB) or pre-incorporation virtual operations. No physical commercial premises."
    },
    "invite_code": {
      "type": "string",
      "description": "Outlet-level invitation code for worker onboarding (e.g. LBT-NBR-001)"
    },
    "invite_code_expiry": {
      "type": "string",
      "format": "date-time",
      "description": "When this invite code expires"
    },
    "invite_code_role": {
      "type": "string",
      "enum": [
        "worker",
        "supervisor",
        "outlet_manager"
      ],
      "description": "Role this invite code grants on redemption"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "temporarily_closed",
        "onboarding"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "client_manager"
                  }
                },
                {
                  "data.id": "{{user.data.outlet_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "$and": [
                {
                  "data.id": "{{user.data.outlet_id}}"
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}