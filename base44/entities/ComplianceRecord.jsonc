{
  "name": "ComplianceRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "e.g. Food Safety Audit, Fire Drill, License Renewal"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_review",
        "submitted",
        "approved",
        "rejected",
        "overdue"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "submitted_date": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string"
    },
    "document_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "food_safety",
        "fire_safety",
        "licensing",
        "hr",
        "environmental",
        "financial",
        "other"
      ]
    },
    "signed_by_id": {
      "type": "string",
      "description": "User ID of the employee who digitally signed off on this compliance record"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Full name of the signer at time of signature"
    },
    "signed_by_role": {
      "type": "string",
      "description": "Role of the signer at time of signature"
    },
    "signed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the digital signature was applied"
    },
    "signature_hash": {
      "type": "string",
      "description": "SHA-256 hash of the record state at time of signing. Tamper-evident proof for SOC 2 audit bundles."
    },
    "audit_log_id": {
      "type": "string",
      "description": "Linked AuditLog entry created by the digitalSignature function \u2014 immutable notary record"
    }
  },
  "required": [
    "tenant_id",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.outlet_id": "{{user.data.outlet_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.outlet_id": "{{user.data.outlet_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "outlet_manager",
                "supervisor",
                "worker"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.outlet_id": "{{user.data.outlet_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "outlet_manager",
                "supervisor"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.outlet_id": "{{user.data.outlet_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "outlet_manager"
          }
        }
      ]
    }
  }
}