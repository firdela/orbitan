{
  "name": "FinanceMapping",
  "type": "object",
  "description": "Maps OrbitanOS entity records to their corresponding Xero GUIDs. Acts as the sync state registry.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "sales_invoice",
        "purchase_order",
        "supplier",
        "reconciliation"
      ]
    },
    "orbitan_record_id": {
      "type": "string"
    },
    "xero_guid": {
      "type": "string"
    },
    "xero_entity_type": {
      "type": "string",
      "enum": [
        "Invoice",
        "Bill",
        "Contact",
        "ManualJournal"
      ]
    },
    "xero_status": {
      "type": "string"
    },
    "sync_direction": {
      "type": "string",
      "enum": [
        "orbitan_to_xero",
        "xero_to_orbitan",
        "bidirectional"
      ],
      "default": "orbitan_to_xero"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_attempts": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tenant_id",
    "entity_type",
    "orbitan_record_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}