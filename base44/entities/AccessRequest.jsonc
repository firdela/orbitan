{
  "name": "AccessRequest",
  "type": "object",
  "description": "OrbitanOS Access Registry \u2014 Governed onboarding pipeline. Every worker access attempt is logged here before an Employee record is created. Regulate principle. Exit-Ready.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the worker requesting access"
    },
    "invite_code": {
      "type": "string",
      "description": "Invitation code used to initiate this request (if the worker entered a code rather than searching). Links to the Invitation entity for redemption tracking."
    },
    "tenant_id": {
      "type": "string",
      "description": "Target tenant/company the worker wants to join"
    },
    "outlet_id": {
      "type": "string",
      "description": "Target outlet (optional \u2014 null for tenant-wide requests)"
    },
    "company_name": {
      "type": "string",
      "description": "Display name of the company (copied at request time for portability)"
    },
    "outlet_name": {
      "type": "string",
      "description": "Display name of the outlet (copied at request time for portability)"
    },
    "role_requested": {
      "type": "string",
      "enum": [
        "worker",
        "supervisor",
        "outlet_manager"
      ],
      "default": "worker",
      "description": "Role the worker is requesting"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "default": "pending",
      "description": "Current state of this access request"
    },
    "manager_notes": {
      "type": "string",
      "description": "Notes from the approving/denying manager"
    },
    "reviewed_by_id": {
      "type": "string",
      "description": "User ID of the manager who reviewed this request"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Name of the manager who reviewed this request"
    },
    "reviewed_date": {
      "type": "string",
      "description": "When the request was reviewed"
    }
  },
  "required": [
    "email",
    "tenant_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}