{
  "name": "MarketplaceModule",
  "type": "object",
  "description": "OrbitanOS Marketplace \u2014 catalog of purchasable modules, integrations, and industry packs. Drives the Reach principle of the 6R Framework. Exit-Ready.",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "Unique identifier e.g. xero_integration, ai_studio"
    },
    "description": {
      "type": "string"
    },
    "long_description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "core_module",
        "industry_pack",
        "integration",
        "ai_feature",
        "compliance_tool",
        "analytics",
        "premium_add_on"
      ],
      "default": "core_module"
    },
    "principle": {
      "type": "string",
      "enum": [
        "renew",
        "relate",
        "respond",
        "refine",
        "regulate",
        "reach"
      ],
      "description": "Which 6R principle this module serves"
    },
    "industry_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. fnb, retail, recycling, all"
    },
    "price_credits": {
      "type": "number",
      "default": 0,
      "description": "One-time Orbitan Credits cost"
    },
    "price_sgd_monthly": {
      "type": "number",
      "default": 0,
      "description": "Monthly SGD subscription add-on"
    },
    "min_plan_required": {
      "type": "string",
      "enum": [
        "orbitan_free",
        "orbitan_starter",
        "orbitan_growth",
        "orbitan_business",
        "orbitan_enterprise"
      ],
      "default": "orbitan_starter"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_new": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "icon_name": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "color_hex": {
      "type": "string",
      "description": "Brand colour for this module"
    },
    "publisher": {
      "type": "string",
      "default": "Orbitan"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "installs_count": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 5.0
    },
    "screenshots_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}