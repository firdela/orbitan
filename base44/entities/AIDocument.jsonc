{
  "name": "AIDocument",
  "type": "object",
  "description": "OrbitanOS AI Suite \u2014 stores all AI-generated documents (SOPs, Training Modules, Policies). Every document enters 'in_review' state and requires manager approval (Regulate principle) before activation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "sop",
        "training_module",
        "policy",
        "shift_brief",
        "incident_report",
        "compliance_checklist"
      ]
    },
    "title": {
      "type": "string"
    },
    "industry_context": {
      "type": "string",
      "enum": [
        "food_beverage",
        "recycling_sustainability",
        "retail",
        "healthcare",
        "education",
        "logistics",
        "other"
      ]
    },
    "principle": {
      "type": "string",
      "enum": [
        "renew",
        "relate",
        "respond",
        "refine",
        "regulate",
        "reach"
      ]
    },
    "content_markdown": {
      "type": "string"
    },
    "source_context": {
      "type": "object"
    },
    "model_used": {
      "type": "string"
    },
    "ai_confidence_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "in_review",
        "approved",
        "rejected",
        "archived",
        "auto_published"
      ],
      "default": "in_review"
    },
    "auto_publish_eligible": {
      "type": "boolean",
      "default": false
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "linked_compliance_id": {
      "type": "string"
    },
    "linked_employee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "document_type",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}