{
  "name": "ComplianceSnapshot",
  "type": "object",
  "description": "OrbitanOS Enterprise Governance \u2014 Persistent compliance health registry. Written by auditEngine on every ComplianceRecord change and on daily schedule. Used for historical auditing and enterprise-grade reporting. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string",
      "description": "Null = enterprise-wide aggregate snapshot"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "snapshot_type": {
      "type": "string",
      "enum": [
        "daily_scheduled",
        "event_triggered",
        "manual"
      ],
      "default": "daily_scheduled"
    },
    "total_records": {
      "type": "number",
      "default": 0
    },
    "approved_count": {
      "type": "number",
      "default": 0
    },
    "pending_count": {
      "type": "number",
      "default": 0
    },
    "in_review_count": {
      "type": "number",
      "default": 0
    },
    "rejected_count": {
      "type": "number",
      "default": 0
    },
    "overdue_count": {
      "type": "number",
      "default": 0
    },
    "compliance_score": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "green",
        "amber",
        "red",
        "critical"
      ],
      "default": "green"
    },
    "category_breakdown": {
      "type": "object"
    },
    "financial_exposure_sgd": {
      "type": "number",
      "default": 0
    },
    "write_offs_triggered": {
      "type": "number",
      "default": 0
    },
    "escalations_triggered": {
      "type": "number",
      "default": 0
    },
    "sops_generated": {
      "type": "number",
      "default": 0
    },
    "triggered_by_record_id": {
      "type": "string"
    },
    "triggered_by_action": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "snapshot_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}