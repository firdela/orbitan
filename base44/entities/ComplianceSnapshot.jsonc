{
  "name": "ComplianceSnapshot",
  "type": "object",
  "description": "OrbitanOS Enterprise Governance \u2014 Persistent compliance health registry. Written by auditEngine on every ComplianceRecord change and on daily schedule. Used for historical auditing and enterprise-grade reporting. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string",
      "description": "Null = enterprise-wide aggregate snapshot"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "Date this snapshot represents"
    },
    "snapshot_type": {
      "type": "string",
      "enum": [
        "daily_scheduled",
        "event_triggered",
        "manual"
      ],
      "default": "daily_scheduled",
      "description": "What triggered this snapshot write"
    },
    "total_records": {
      "type": "number",
      "default": 0
    },
    "approved_count": {
      "type": "number",
      "default": 0
    },
    "pending_count": {
      "type": "number",
      "default": 0
    },
    "in_review_count": {
      "type": "number",
      "default": 0
    },
    "rejected_count": {
      "type": "number",
      "default": 0
    },
    "overdue_count": {
      "type": "number",
      "default": 0
    },
    "compliance_score": {
      "type": "number",
      "description": "0-100 health score: (approved / total) * 100"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "green",
        "amber",
        "red",
        "critical"
      ],
      "default": "green",
      "description": "Derived risk tier: green=90+, amber=70-89, red=50-69, critical=<50"
    },
    "category_breakdown": {
      "type": "object",
      "description": "Per-category counts: { food_safety: { approved, rejected, overdue }, fire_safety: {...}, ... }"
    },
    "financial_exposure_sgd": {
      "type": "number",
      "default": 0,
      "description": "Total estimated financial impact of all active compliance failures at time of snapshot"
    },
    "write_offs_triggered": {
      "type": "number",
      "default": 0,
      "description": "Number of FinanceSyncQueue write-off entries triggered by compliance failures in this period"
    },
    "escalations_triggered": {
      "type": "number",
      "default": 0,
      "description": "Number of tenant_admin escalation tasks auto-created in this period"
    },
    "sops_generated": {
      "type": "number",
      "default": 0,
      "description": "Number of corrective action SOPs auto-generated by sopGenerator in this period"
    },
    "triggered_by_record_id": {
      "type": "string",
      "description": "If event_triggered: the ComplianceRecord ID that caused this snapshot"
    },
    "triggered_by_action": {
      "type": "string",
      "description": "e.g. compliance_rejected, compliance_overdue"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "snapshot_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}