{
  "name": "GovernancePolicy",
  "type": "object",
  "description": "OrbitanOS Shield\u2122 \u2014 Policy-as-Code registry. Defines operational governance rules evaluated by the Shield Interceptor before sensitive actions. Supports human and agentic AI actors (ADR-0029). Auditor mode = notify. Guardian mode = block. Shadow Audit Mode downgrades block \u2192 notify for safe threshold calibration. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "domain_id": {
      "type": "string",
      "description": "Protection Domain identifier: 'Domain_A' (Financial Integrity), 'Domain_B' (Access & Identity), 'Domain_C' (Operational Trust). Enables domain-based policy resolution."
    },
    "policy_name": {
      "type": "string",
      "description": "Unique human-readable identifier e.g. 'no_log_deletion', 'finance_threshold_gate', 'procurement_agent_autonomy_gate'"
    },
    "description": {
      "type": "string"
    },
    "target_entity": {
      "type": "string",
      "description": "Entity this policy governs e.g. AuditLog, FinanceSyncQueue, ClockRecord, PurchaseOrder, Shift"
    },
    "trigger_action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "all"
      ],
      "default": "all"
    },
    "condition_json": {
      "type": "object",
      "description": "Rule conditions \u2014 e.g. {role_not: 'admin'} or {amount_gt: 500} or {field: 'status', value: 'rejected'}"
    },
    "effect": {
      "type": "string",
      "enum": [
        "block",
        "notify",
        "auto_remediate"
      ],
      "default": "notify",
      "description": "block = Guardian hard stop | notify = Auditor alert | auto_remediate = automated correction"
    },
    "shield_mode": {
      "type": "string",
      "enum": [
        "auditor",
        "guardian"
      ],
      "default": "auditor",
      "description": "Auditor = Starter/Growth plans | Guardian = Enterprise plans only"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "principle": {
      "type": "string",
      "enum": [
        "regulate",
        "refine",
        "respond",
        "renew",
        "relate",
        "reach"
      ],
      "default": "regulate",
      "description": "Which 6R principle this policy enforces"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "both"
      ],
      "default": "both",
      "description": "ADR-0029: Whether this policy governs human actions, AI agent actions, or both. 'both' is the backward-compatible default for pre-existing policies."
    },
    "agent_name": {
      "type": "string",
      "description": "ADR-0029: Specific agent slug this policy targets (e.g. 'procurement_agent', 'inventory_agent'). Null/empty = applies to all agents. Only evaluated when applies_to is 'agent' or 'both'."
    },
    "agent_trust_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "ADR-0029: Trust tier this policy gates. low = agent requires approval for all writes | medium = autonomous within threshold gates | high = autonomous (enterprise only)."
    },
    "agentic_threshold_sgd": {
      "type": "number",
      "description": "ADR-0029: Monetary threshold (in tenant currency) for autonomous agent actions. Actions below this value proceed; at or above, the policy effect triggers. Used by condition_json amount_gt comparisons in agentic contexts."
    },
    "shadow_audit_mode": {
      "type": "boolean",
      "default": false,
      "description": "ADR-0029: When true, block effects are downgraded to notify \u2014 the action proceeds but a 'would-have-blocked' AuditLog entry is written with shadow_audit: true. Used for 14-day threshold calibration before enforcing hard gates. Auto-expires at shadow_audit_until."
    },
    "shadow_audit_until": {
      "type": "string",
      "format": "date-time",
      "description": "ADR-0029: When shadow_audit_mode expires. After this timestamp, the policy resumes its native effect (block). Set by tenant_admin during rollout."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "auto_remediation_action": {
      "type": "string",
      "description": "What auto_remediate does e.g. 'pause_sync', 'flag_record', 'notify_admin'"
    },
    "violations_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime count of policy violations triggered"
    },
    "shadow_audit_hits": {
      "type": "number",
      "default": 0,
      "description": "ADR-0029: Count of Shadow Audit 'would-have-blocked' events during calibration. Used to tune thresholds before switching to hard-gate enforcement."
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "policy_name",
    "target_entity",
    "effect"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}