{
  "name": "WalletTransaction",
  "type": "object",
  "description": "OrbitanOS \u2014 Immutable transaction ledger for all wallet events (credits debited, points earned, cashback, marketplace purchases, procurement spending). The single source of truth for all financial movements. Linked to AuditLog for governance and FinanceSyncQueue for ERP bridging. Exit-Ready.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string",
      "description": "Outlet context for procurement transactions (null = tenant-wide)"
    },
    "wallet_id": {
      "type": "string",
      "description": "Linked OrbitanWallet record ID"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "credit_topup",
        "credit_debit_ai",
        "credit_debit_module",
        "credit_debit_marketplace",
        "credit_debit_procurement",
        "points_earned_referral",
        "points_earned_training",
        "points_earned_renewal",
        "points_earned_review",
        "points_redeemed",
        "cashback_earned",
        "cashback_redeemed",
        "subscription_renewal",
        "module_unlock",
        "procurement_debit_sgd",
        "system_adjustment"
      ],
      "description": "Type of wallet event. procurement_debit_sgd = SGD spent on PurchaseOrder goods receipt."
    },
    "amount": {
      "type": "number",
      "description": "Positive = credit/earn, Negative = debit/spend. For SGD procurement, this is the PO total in SGD."
    },
    "currency": {
      "type": "string",
      "enum": [
        "credits",
        "points",
        "sgd"
      ],
      "description": "What was transacted"
    },
    "balance_after": {
      "type": "number",
      "description": "Balance snapshot after this transaction (for credits/points). For SGD, this is cumulative SGD spent this period."
    },
    "description": {
      "type": "string"
    },
    "reference_id": {
      "type": "string",
      "description": "Linked record ID (PO ID, AI doc ID, module ID, etc.)"
    },
    "reference_type": {
      "type": "string",
      "description": "e.g. PurchaseOrder, AIDocument, ModuleUnlock, SubscriptionRenewal"
    },
    "triggered_by": {
      "type": "string",
      "description": "User ID or system process that triggered this"
    },
    "triggered_by_name": {
      "type": "string"
    },
    "module_used": {
      "type": "string",
      "description": "Which OrbitanOS module consumed the credit"
    },
    "ai_model_used": {
      "type": "string",
      "description": "AI model if credit_debit_ai"
    },
    "governance_threshold_applied": {
      "type": "boolean",
      "default": false,
      "description": "True if this transaction was evaluated against a Dynamic Trust governance threshold"
    },
    "threshold_value_sgd": {
      "type": "number",
      "description": "The governance threshold value at time of transaction (from ActivationRegistry)"
    },
    "governance_override_id": {
      "type": "string",
      "description": "If above threshold, links to the GovernanceOverride record for manager approval"
    },
    "finance_sync_queue_id": {
      "type": "string",
      "description": "Linked FinanceSyncQueue entry for ERP bridging (future Xero/QuickBooks sync)"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "reversed",
        "failed",
        "pending_approval"
      ],
      "default": "completed",
      "description": "pending_approval = above governance threshold, awaiting manager override decision"
    },
    "metadata": {
      "type": "object",
      "description": "Any extra data for audit trail (PO items, supplier info, etc.)"
    }
  },
  "required": [
    "tenant_id",
    "transaction_type",
    "amount",
    "currency"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}