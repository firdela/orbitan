{
  "name": "MetricDefinition",
  "type": "object",
  "description": "OrbitanOS Metrics & Analytics Registry (ADR-0033) \u2014 Single source of truth for every quantitative KPI across the platform. Each record declares a metric's formula reference, source entities, aggregation mode, and display metadata. The metricsEngine backend function evaluates a definition and returns a standardised result. Prevents conflicting inline calculations across dashboards. Tenant-overridable for white-label/enterprise customisation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this definition belongs to. 'system' = platform-default metric available to all tenants."
    },
    "metric_key": {
      "type": "string",
      "description": "Unique metric identifier e.g. 'labour_cost_pct', 'inventory_value_sgd', 'inventory_turnover', 'po_pending_count'. The metricsEngine resolves by (tenant_id, metric_key) with fallback to system default."
    },
    "module": {
      "type": "string",
      "enum": [
        "finance",
        "inventory",
        "procurement",
        "workforce",
        "compliance",
        "sales",
        "scheduling",
        "retail",
        "sustainability",
        "system"
      ],
      "description": "Owning module \u2014 used for grouping, filtering, and dashboard scoping"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name shown on dashboards e.g. 'Inventory Value (SGD)'"
    },
    "description": {
      "type": "string",
      "description": "What the metric measures and why it matters \u2014 surfaced in contextual help on dashboards"
    },
    "unit": {
      "type": "string",
      "enum": [
        "currency",
        "count",
        "percentage",
        "hours",
        "days",
        "ratio",
        "none"
      ],
      "default": "count"
    },
    "aggregation_mode": {
      "type": "string",
      "enum": [
        "sum",
        "ratio",
        "count",
        "average",
        "custom"
      ],
      "description": "How source values are combined. sum = add a field across source records. ratio = numerator_field / denominator_field. count = number of matching records. average = mean of a field. custom = formula_ref names a function in metricsEngine."
    },
    "source_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entity types the metric reads from e.g. ['InventoryItem'], ['PurchaseOrder'], ['Shift', 'SalesInvoice']. Used by the engine for scoping and by auditors to trace a reported number."
    },
    "source_filter": {
      "type": "object",
      "description": "Additional filter applied to source records beyond tenant_id/outlet_id scoping e.g. {status: 'active'} for inventory_value_sgd."
    },
    "value_field": {
      "type": "string",
      "description": "Field path summed/averaged for sum/average modes e.g. 'current_stock_value_sgd', 'total_amount'. Null for count mode."
    },
    "numerator_field": {
      "type": "string",
      "description": "Numerator field path for ratio mode."
    },
    "denominator_field": {
      "type": "string",
      "description": "Denominator field path for ratio mode."
    },
    "formula_ref": {
      "type": "string",
      "description": "Named computation in the metricsEngine for custom mode e.g. 'labour_cost_as_pct_of_revenue'. Versioned via formula_version."
    },
    "formula_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Semantic version of the formula \u2014 bump when computation logic changes for audit traceability."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system_default": {
      "type": "boolean",
      "default": false,
      "description": "True for platform-seeded definitions (tenant_id='system'). Read-only for non-admins; serve as fallback when a tenant has no custom override."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "metric_key",
    "module",
    "display_name",
    "aggregation_mode",
    "source_entities"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "system"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "user_condition": {
                    "role": "worker"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}