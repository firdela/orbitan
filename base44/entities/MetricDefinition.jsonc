{
  "name": "MetricDefinition",
  "type": "object",
  "description": "OrbitanOS Metrics & Analytics Registry (ADR-0033) \u2014 Single source of truth for every quantitative KPI across the platform. Each record declares a metric's formula reference, source entities, aggregation mode, and display metadata. The metricsEngine backend function evaluates a definition and returns a standardised result. Prevents conflicting inline calculations across dashboards. Tenant-overridable for white-label/enterprise customisation. Observability Stream: threshold_config lets a metric emit a breach event to actionDispatcher, making the registry an event source for the Action Engine (ADR-0032) rather than a parallel action executor. Drill-Down Config (ADR-0040): each metric declares its own navigation destination and interaction pattern, enabling registry-driven dashboard drill-downs with zero hardcoded routing in the UI layer. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this definition belongs to. 'system' = platform-default metric available to all tenants."
    },
    "metric_key": {
      "type": "string",
      "description": "Unique metric identifier e.g. 'labour_cost_pct', 'inventory_value_sgd', 'inventory_turnover', 'po_pending_count'. The metricsEngine resolves by (tenant_id, metric_key) with fallback to system default."
    },
    "module": {
      "type": "string",
      "enum": [
        "finance",
        "inventory",
        "procurement",
        "workforce",
        "compliance",
        "sales",
        "scheduling",
        "retail",
        "sustainability",
        "system"
      ],
      "description": "Owning module \u2014 used for grouping, filtering, and dashboard scoping"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name shown on dashboards e.g. 'Inventory Value (SGD)'"
    },
    "description": {
      "type": "string",
      "description": "What the metric measures and why it matters \u2014 surfaced in contextual help on dashboards"
    },
    "unit": {
      "type": "string",
      "enum": [
        "currency",
        "count",
        "percentage",
        "hours",
        "days",
        "ratio",
        "none"
      ],
      "default": "count"
    },
    "aggregation_mode": {
      "type": "string",
      "enum": [
        "sum",
        "ratio",
        "count",
        "average",
        "custom"
      ],
      "description": "How source values are combined. sum = add a field across source records. ratio = numerator_field / denominator_field. count = number of matching records. average = mean of a field. custom = formula_ref names a function in metricsEngine."
    },
    "source_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Entity types the metric reads from e.g. ['InventoryItem'], ['PurchaseOrder'], ['Shift', 'SalesInvoice']. Used by the engine for scoping and by auditors to trace a reported number."
    },
    "source_filter": {
      "type": "object",
      "description": "Additional filter applied to source records beyond tenant_id/outlet_id scoping e.g. {status: 'active'} for inventory_value_sgd."
    },
    "value_field": {
      "type": "string",
      "description": "Field path summed/averaged for sum/average modes e.g. 'current_stock_value_sgd', 'total_amount'. Null for count mode."
    },
    "numerator_field": {
      "type": "string",
      "description": "Numerator field path for ratio mode."
    },
    "denominator_field": {
      "type": "string",
      "description": "Denominator field path for ratio mode."
    },
    "formula_ref": {
      "type": "string",
      "description": "Named computation in the metricsEngine for custom mode e.g. 'inventory_value_sgd', 'labour_cost_as_pct_of_revenue'. Versioned via formula_version."
    },
    "formula_version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Semantic version of the formula \u2014 bump when computation logic changes for audit traceability."
    },
    "drilldown_config": {
      "type": "object",
      "description": "ADR-0040 Registry-Driven Drill-Down: declares the navigation destination and interaction pattern for this metric's dashboard widget. The WorkspaceDashboard reads this to wire StatCard `to`/`onClick` props dynamically \u2014 zero hardcoded routing in the UI layer. Omit for pure display metrics with no drill-down.",
      "properties": {
        "route": {
          "type": "string",
          "description": "Destination route path. Use ':tenantId' placeholder for tenant-scoped navigation e.g. '/workspace/:tenantId/inventory'. The dashboard resolves this to the active tenant at render time."
        },
        "pattern": {
          "type": "string",
          "enum": [
            "navigate",
            "side_sheet"
          ],
          "default": "navigate",
          "description": "navigate = standard page navigation (default, best for full-screen views like PO editing). side_sheet = contextual drawer overlay (best for high-frequency quick-look actions where dashboard context must persist)."
        },
        "query_params": {
          "type": "object",
          "description": "Optional context-aware query parameters appended to the route for pre-filtered landing e.g. {status: 'pending', filter: 'low_stock'}. The destination page reads these via URLSearchParams to show only relevant records."
        }
      }
    },
    "threshold_config": {
      "type": "object",
      "description": "ADR-0033 Observability Stream: when the computed value crosses these bounds, metricsEngine emits trigger_event to actionDispatcher. This makes the registry an event SOURCE for the Action Engine (ADR-0032), keeping all remediation logic in one place. Omit for pure display metrics with no automation.",
      "properties": {
        "warn_above": {
          "type": "number",
          "description": "Value above which a 'warn_above' breach event is emitted."
        },
        "warn_below": {
          "type": "number",
          "description": "Value below which a 'warn_below' breach event is emitted."
        },
        "critical_above": {
          "type": "number",
          "description": "Value above which a 'critical_above' breach event is emitted (higher severity)."
        },
        "critical_below": {
          "type": "number",
          "description": "Value below which a 'critical_below' breach event is emitted (higher severity)."
        },
        "trigger_event": {
          "type": "string",
          "description": "Event key emitted to actionDispatcher on breach e.g. 'metric.po_pending_high', 'metric.inventory_value_low'. An AutomationRule with this trigger_event performs the remediation."
        },
        "cooldown_minutes": {
          "type": "number",
          "default": 60,
          "description": "Minimum minutes between emissions for the same metric to prevent alert fatigue. 0 = no cooldown."
        }
      }
    },
    "last_breach_emitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last threshold breach event emitted. Used by the engine to enforce cooldown_minutes."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system_default": {
      "type": "boolean",
      "default": false,
      "description": "True for platform-seeded definitions (tenant_id='system'). Read-only for non-admins; serve as fallback when a tenant has no custom override."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "metric_key",
    "module",
    "display_name",
    "aggregation_mode",
    "source_entities"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "system"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "user_condition": {
                    "role": "worker"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}