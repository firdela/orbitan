{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string",
      "description": "e.g. Net 30, COD"
    },
    "lead_time_days": {
      "type": "number"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_preferred": {
      "type": "boolean",
      "default": false,
      "description": "Marks this supplier as a preferred/vetted source. The ReplenishmentEngine autopilot will only raise POs against preferred suppliers for critical F&B ingredient stock."
    },
    "is_critical_fnb": {
      "type": "boolean",
      "default": false,
      "description": "True for suppliers that provide critical F&B ingredients (proteins, produce). Autopilot prioritises these over generic supply suppliers."
    },
    "min_order_value": {
      "type": "number",
      "description": "Minimum order value in tenant currency (SGD). Used by autopilot to consolidate POs."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager",
                "supervisor",
                "worker"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "tenant_admin",
                "outlet_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "tenant_admin"
          }
        }
      ]
    }
  }
}