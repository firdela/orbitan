{
  "name": "Client",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "industry_pack": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}