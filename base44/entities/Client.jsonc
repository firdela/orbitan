{
  "name": "Client",
  "type": "object",
  "description": "OrbitanOS CRM Module \u2014 external client and partner directory with business details and primary points of contact. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Client or partner organisation name"
    },
    "brand": {
      "type": "string"
    },
    "industry_pack": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the client/partner relationship"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "customer",
        "supplier_partner",
        "service_provider",
        "distributor",
        "consultant",
        "other"
      ],
      "default": "customer",
      "description": "Type of external relationship"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary point of contact name"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_position": {
      "type": "string",
      "description": "POC job title"
    },
    "address": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Singapore"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "prospective",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}