{
  "name": "SalesInvoice",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "cogs": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "cogs_total": {
      "type": "number"
    },
    "gross_profit": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "transfer",
        "paynow",
        "other"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "document_url": {
      "type": "string",
      "description": "Uploaded source document / PayNow slip (image/PDF) \u2014 MANDATORY before verification"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "awaiting_evidence",
        "raw",
        "ai_processing",
        "needs_review",
        "verified",
        "rejected"
      ],
      "default": "awaiting_evidence",
      "description": "Document capture and human-in-the-loop review state"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason provided by manager when rejecting a document"
    },
    "ai_confidence_score": {
      "type": "number",
      "description": "AI extraction confidence 0-100"
    },
    "raw_ai_output": {
      "type": "object",
      "description": "Raw AI extracted data before human verification"
    },
    "verified_by": {
      "type": "string",
      "description": "User ID who verified the document"
    },
    "verified_by_name": {
      "type": "string",
      "description": "Name of manager who verified"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "xero_guid": {
      "type": "string",
      "description": "Xero Invoice GUID after sync"
    },
    "xero_sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "syncing",
        "synced",
        "error"
      ],
      "default": "not_synced"
    },
    "xero_sync_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_error": {
      "type": "string",
      "description": "Last Xero sync error message"
    },
    "audit_trail": {
      "type": "array",
      "description": "Immutable log of all state changes",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "outlet_id",
    "date"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "client_manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.outlet_id": "{{user.data.outlet_id}}"
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "data.outlet_id": "{{user.data.outlet_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    }
  }
}