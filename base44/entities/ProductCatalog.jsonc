{
  "name": "ProductCatalog",
  "type": "object",
  "description": "Retail Pack \u2014 product catalog for upcycled/reused clothing and sustainable goods. Supports condition grading, price banding, and sustainability impact tracking.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tops",
        "bottoms",
        "outerwear",
        "footwear",
        "accessories",
        "bags",
        "home_goods",
        "other"
      ],
      "default": "other"
    },
    "sub_category": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "mens",
        "womens",
        "unisex",
        "kids",
        "not_applicable"
      ],
      "default": "unisex"
    },
    "size": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "condition_grade": {
      "type": "string",
      "enum": [
        "A_new_with_tags",
        "B_like_new",
        "C_good",
        "D_fair",
        "E_upcycled"
      ],
      "default": "C_good"
    },
    "sourced_from": {
      "type": "string",
      "enum": [
        "recycling_stream",
        "donation",
        "trade_in",
        "direct_purchase",
        "partner"
      ],
      "default": "recycling_stream"
    },
    "linked_collection_id": {
      "type": "string"
    },
    "selling_price_sgd": {
      "type": "number"
    },
    "original_rrp_sgd": {
      "type": "number"
    },
    "cost_price_sgd": {
      "type": "number"
    },
    "gross_margin_pct": {
      "type": "number"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "stock_location": {
      "type": "string"
    },
    "is_pos_ready": {
      "type": "boolean",
      "default": false
    },
    "is_online_listed": {
      "type": "boolean",
      "default": false
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sustainability_impact": {
      "type": "object",
      "properties": {
        "co2_saved_kg": {
          "type": "number"
        },
        "water_saved_litres": {
          "type": "number"
        },
        "landfill_diverted_kg": {
          "type": "number"
        },
        "impact_label": {
          "type": "string"
        }
      }
    },
    "upcycling_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "sold",
        "reserved",
        "damaged",
        "returned",
        "archived"
      ],
      "default": "draft"
    },
    "sold_date": {
      "type": "string",
      "format": "date"
    },
    "sold_to_customer_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "condition_grade"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    }
  }
}