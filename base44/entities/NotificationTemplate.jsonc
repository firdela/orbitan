{
  "name": "NotificationTemplate",
  "type": "object",
  "description": "OrbitanOS Unified Notification Pipeline (ADR-0031) \u2014 Registry of configurable notification templates consumed by the notificationDispatcher. Decouples notification *trigger* (the event) from *delivery* (the medium + copy). Tenant-overridable copy supports white-label/enterprise customisation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant this template belongs to. 'system' = platform-default template available to all tenants."
    },
    "template_key": {
      "type": "string",
      "description": "Unique template identifier, namespaced by module e.g. 'shift_reminder', 'compliance_overdue', 'po_approval_request', 'replenishment_alert'. The dispatcher resolves by (tenant_id, template_key) with fallback to system default."
    },
    "module": {
      "type": "string",
      "enum": [
        "finance",
        "inventory",
        "procurement",
        "workforce",
        "compliance",
        "sales",
        "scheduling",
        "retail",
        "sustainability",
        "system"
      ],
      "description": "Owning module \u2014 used for grouping and admin filtering"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label shown in the admin template manager"
    },
    "subject_template": {
      "type": "string",
      "description": "Subject line with {{mustache}} placeholders resolved from the dispatcher payload e.g. 'Shift Reminder \u2014 {{shift_date}} at {{start_time}}'"
    },
    "body_template": {
      "type": "string",
      "description": "Email/body content with {{mustache}} placeholders. Supports plain text or HTML depending on delivery channel. Resolved against the dispatcher payload."
    },
    "delivery_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "in_app",
          "webhook"
        ]
      },
      "default": [
        "email"
      ],
      "description": "Channels the dispatcher will attempt for this template, in priority order."
    },
    "from_name": {
      "type": "string",
      "description": "Sender display name for email delivery. Defaults to the app name when omitted."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_system_default": {
      "type": "boolean",
      "default": false,
      "description": "True for platform-seeded templates (tenant_id='system'). These are read-only for non-admins and serve as fallbacks when a tenant has no custom override."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "template_key",
    "module",
    "subject_template",
    "body_template"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "system"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}