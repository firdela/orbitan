{
  "name": "AccountMapping",
  "type": "object",
  "description": "Maps OrbitanOS product/expense categories to Xero Chart of Accounts codes. Drives automated journal entry creation in financeController.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "category_type": {
      "type": "string",
      "enum": [
        "revenue",
        "cogs",
        "expense",
        "labour",
        "asset"
      ]
    },
    "xero_account_code": {
      "type": "string"
    },
    "xero_account_name": {
      "type": "string"
    },
    "xero_account_type": {
      "type": "string",
      "enum": [
        "REVENUE",
        "DIRECTCOSTS",
        "EXPENSE",
        "OVERHEADS",
        "CURRENT",
        "FIXED"
      ]
    },
    "tax_type": {
      "type": "string",
      "default": "NONE"
    },
    "tax_rate_pct": {
      "type": "number",
      "default": 0
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "category_name",
    "xero_account_code"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}