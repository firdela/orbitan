{
  "name": "AuditLog",
  "type": "object",
  "description": "Global, immutable audit trail registry for all high-value events across OrbitanOS. Powers the Global Activity Timeline & Audit Centre (ADR-0054) and the Audit Bundle (SOC 2). ADR-0054 adds additive metadata (severity, category, event_source, link, related_user_id, related_workflow) for timeline classification and Orbit Nexus consumption \u2014 fully backward-compatible. Exit-ready \u2014 portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string",
      "description": "User ID who performed the action"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string",
      "description": "Role of the user at time of action"
    },
    "action_type": {
      "type": "string",
      "description": "Standardised action key e.g. document_verified, stock_adjusted, status_changed, clock_out, override_approved"
    },
    "module": {
      "type": "string",
      "enum": [
        "finance",
        "inventory",
        "procurement",
        "workforce",
        "compliance",
        "sales",
        "scheduling",
        "retail",
        "sustainability",
        "system"
      ],
      "description": "Which OrbitanOS module generated this event"
    },
    "category": {
      "type": "string",
      "enum": [
        "operational",
        "lifecycle",
        "access",
        "governance",
        "security",
        "ai",
        "system"
      ],
      "default": "operational",
      "description": "ADR-0054 \u2014 Higher-level event classification for the Activity Timeline. 'operational' = business actions (auditEngine); 'lifecycle' = tenant/workspace/user creation; 'access' = login/role changes; 'governance' = overrides/policy; 'security' = shield blocks/threats; 'ai' = Nexus insights; 'system' = config/infrastructure."
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "critical"
      ],
      "default": "info",
      "description": "ADR-0054 \u2014 Deterministic severity for timeline prioritisation. Derived from action_type by the auditEngine. Independent of shield_outcome (which tracks policy evaluation)."
    },
    "event_source": {
      "type": "string",
      "description": "ADR-0054 \u2014 The engine/function that wrote this record e.g. 'auditEngine', 'shieldInterceptor', 'digitalSignature', 'notificationDispatcher', 'system'. Enables source filtering in the Audit Centre."
    },
    "target_entity": {
      "type": "string",
      "description": "Entity type affected e.g. SalesInvoice, ComplianceRecord, ClockRecord"
    },
    "target_record_id": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "description": "ADR-0054 \u2014 Best-effort deep link to the source record's page for one-click navigation from the timeline."
    },
    "related_user_id": {
      "type": "string",
      "description": "ADR-0054 \u2014 Another user referenced by this event (e.g. the user who was onboarded, invited, or whose role changed). actor_id is the performer; related_user_id is the subject. Null for most operational events."
    },
    "related_workflow": {
      "type": "string",
      "description": "ADR-0054 \u2014 Workflow name if this event is part of a multi-step workflow e.g. 'payroll_run', 'po_approval', 'compliance_review'. Null for standalone events."
    },
    "previous_state": {
      "type": "object",
      "description": "Snapshot of the record before the change"
    },
    "new_state": {
      "type": "object",
      "description": "Snapshot of the record after the change"
    },
    "details": {
      "type": "string",
      "description": "Human-readable description of what changed"
    },
    "ip_address": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked artifact URLs \u2014 uploaded documents, photos, certificates attached as evidence for this event. Powers the Audit Bundle."
    },
    "override_id": {
      "type": "string",
      "description": "If this event resulted from a manager override, links to the GovernanceOverride record"
    },
    "justification": {
      "type": "string",
      "description": "Human-readable reason for an override or exception \u2014 mandatory when an action bypasses a governance policy"
    },
    "policy_name": {
      "type": "string",
      "description": "If a Shield policy was evaluated for this action, the policy name that was considered"
    },
    "shield_outcome": {
      "type": "string",
      "enum": [
        "pass",
        "blocked",
        "notify",
        "override_requested",
        "override_approved",
        "override_denied",
        "not_evaluated"
      ],
      "default": "not_evaluated",
      "description": "Result of Shield evaluation for this event. 'notify' = soft-gate warning (action allowed but flagged for audit). 'blocked' = hard-gate (action prevented). 'override_*' = governance override lifecycle."
    }
  },
  "required": [
    "tenant_id",
    "actor_id",
    "action_type",
    "target_entity",
    "target_record_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.actor_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}