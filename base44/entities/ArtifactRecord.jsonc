{
  "name": "ArtifactRecord",
  "type": "object",
  "description": "OrbitanOS Unified Artifact Engine (ADR-0025) \u2014 Centralised, audit-bound storage for all platform artifacts: compliance permits, operational SOPs, financial receipts, legal contracts, training materials, incident evidence, and facility documents. Replaces siloed document storage with a single SOC 2-ready registry. Every record is linked to an immutable AuditLog entry via entity automation. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "compliance_permit",
        "operational_sop",
        "financial_receipt",
        "legal_contract",
        "training_material",
        "incident_evidence",
        "facility_document"
      ],
      "description": "Classifies the artifact for policy resolution, UI rendering, and audit-bundle generation"
    },
    "title": {
      "type": "string",
      "description": "Human-readable artifact title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of what the artifact contains or proves"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_upload",
        "in_review",
        "approved",
        "rejected",
        "archived",
        "expired"
      ],
      "default": "pending_upload",
      "description": "Review lifecycle \u2014 all artifacts enter pending_upload, transition to in_review upon upload, require manager approval (Regulate) before activation"
    },
    "storage_url": {
      "type": "string",
      "description": "Uploaded file URL (image, PDF, document). Set after UploadFile integration completes."
    },
    "file_name": {
      "type": "string",
      "description": "Original file name at time of upload"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "image",
        "pdf",
        "document",
        "spreadsheet",
        "other"
      ],
      "description": "Detected file category for rendering"
    },
    "file_size_kb": {
      "type": "number",
      "description": "File size in kilobytes"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Artifact version \u2014 incremented on re-upload or re-generation"
    },
    "metadata": {
      "type": "object",
      "description": "Flexible JSON for artifact-specific data: OCR results for receipts, expiry dates for permits, AI confidence for generated SOPs, extracted text for RAG indexing"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiry date for time-bound artifacts (permits, licenses, certifications). Triggers expiry alerts via complianceAlertEngine."
    },
    "uploaded_by": {
      "type": "string",
      "description": "User ID who uploaded the artifact"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "description": "User ID of manager who reviewed/approved"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "linked_entity_type": {
      "type": "string",
      "description": "Entity type this artifact is linked to e.g. 'ComplianceRecord', 'ExpenseRecord', 'Employee', 'PurchaseOrder'"
    },
    "linked_entity_id": {
      "type": "string",
      "description": "Record ID of the linked entity"
    },
    "governance_policy_id": {
      "type": "string",
      "description": "GovernancePolicy ID that dictates this artifact's review gate. Resolved by shieldInterceptor."
    },
    "audit_log_id": {
      "type": "string",
      "description": "Immutable reference to the AuditLog entry recording this artifact's lifecycle. Populated by entity automation (auditEngine)."
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "True if this artifact was generated by Orbit Nexus AI (sopGenerator, AIReceipts OCR) rather than manually uploaded"
    },
    "ai_source": {
      "type": "string",
      "description": "AI generation source e.g. 'sopGenerator', 'ai_receipts_ocr'"
    },
    "industry_context": {
      "type": "string",
      "enum": [
        "food_beverage",
        "recycling_sustainability",
        "retail",
        "healthcare",
        "education",
        "logistics",
        "events_activations",
        "technology_software",
        "facilities_management",
        "other"
      ],
      "description": "Industry context for AI-generated artifacts \u2014 injects context into prompts"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. food_safety, xero_sync, onboarding, soc2_evidence"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "artifact_type",
    "title"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "user_condition": {
                "role": "worker"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "client_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                },
                {
                  "user_condition": {
                    "role": "worker"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "client_manager"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            },
            {
              "data.uploaded_by": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            }
          ]
        }
      ]
    }
  }
}