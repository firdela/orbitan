{
  "name": "Employee",
  "type": "object",
  "description": "OrbitanOS Workforce Module \u2014 Centralised staff directory record. Stores employee profiles, contact information, organisational assignments (Company \u2192 Brand \u2192 Outlet \u2192 Department \u2192 Team), roles, employment status, skills, certifications, emergency contacts, and employment history. Governed by RBAC and tenant isolation (ADR-0027). Orbit Identity Model: the User entity is the global identity; an Employee record is a tenant-scoped membership. One User may hold many Employee records (one per tenant/organisation), linked via `user_id`. Exit-Ready: pure schema, portable to any stack.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Orbit Identity Model link to the global User account. Nullable for directory entries whose owner has not yet registered/claimed their account. On registration or invitation redemption, the onboarding flow links the User to the matching Employee record by email."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "tenant_admin",
        "client_manager",
        "outlet_manager",
        "worker",
        "supervisor"
      ],
      "default": "worker"
    },
    "position": {
      "type": "string",
      "description": "Job title / position within the organisation"
    },
    "department": {
      "type": "string",
      "description": "Department or cost centre e.g. Kitchen, Front of House, Operations"
    },
    "team": {
      "type": "string",
      "description": "Team assignment within the department"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "temporary"
      ],
      "default": "full_time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_leave",
        "terminated"
      ],
      "default": "active"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "termination_date": {
      "type": "string",
      "format": "date",
      "description": "Date of employment termination if status is terminated"
    },
    "avatar_url": {
      "type": "string"
    },
    "pay_rate": {
      "type": "number"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "monthly",
        "daily"
      ],
      "default": "monthly"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. ['Food Safety Level 2', 'Barista', 'Cashier', 'Inventory Management']"
    },
    "certifications": {
      "type": "array",
      "description": "Professional certifications with expiry tracking for compliance",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "cert_id": {
            "type": "string"
          }
        }
      }
    },
    "emergency_contact": {
      "type": "object",
      "description": "Primary emergency contact for the employee",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        }
      }
    },
    "employment_history": {
      "type": "array",
      "description": "Chronological record of position/assignment changes within the tenant. Appended on each role or outlet assignment change for audit traceability.",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string"
          },
          "outlet_id": {
            "type": "string"
          },
          "outlet_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "change_reason": {
            "type": "string",
            "description": "e.g. 'Promotion', 'Transfer', 'Role change', 'Onboarding'"
          }
        }
      }
    }
  },
  "required": [
    "tenant_id",
    "full_name",
    "role"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "client_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.outlet_id": "{{user.data.outlet_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "tenant_admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "data.outlet_id": "{{user.data.outlet_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "outlet_manager"
                  }
                },
                {
                  "user_condition": {
                    "role": "supervisor"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "tenant_admin"
              }
            },
            {
              "user_condition": {
                "role": "outlet_manager"
              }
            }
          ]
        }
      ]
    }
  }
}